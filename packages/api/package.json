{
  "name": "@bootible/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "bootible cloud API — Cloudflare Worker (better-auth + D1) for accounts & E2E profile sync.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "better-auth generate --config ./scripts/auth.cli.ts --output ./migrations/0000_better_auth.sql -y",
    "dev": "wrangler dev",
    "migrate:local": "wrangler d1 migrations apply bootible-local --local",
    "migrate:staging": "wrangler d1 migrations apply bootible-staging --remote --env staging",
    "migrate:production": "wrangler d1 migrations apply bootible --remote --env production",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@cloudflare/workers-types": "^4.20260627.1",
    "better-sqlite3": "^12.11.1",
    "kysely": "^0.28.17",
    "wrangler": "^4.105.0"
  },
  "dependencies": {
    "better-auth": "^1.6.22",
    "better-auth-cloudflare": "^0.3.0",
    "hono": "^4.12.27"
  }
}
